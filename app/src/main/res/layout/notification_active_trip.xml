<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="8dp">

    <!-- Top Action Row: Header Icon + Title & Subtitle + Cancel Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top-left Header Icon (Mode Icon) -->
        <ImageView
            android:id="@+id/notif_mode_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Icono de transporte" />

        <!-- Cancel / Finish Trip Button -->
        <ImageButton
            android:id="@+id/notif_btn_cancel"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_notification"
            android:contentDescription="Finalizar viaje" />

        <!-- Step Title & Subtitle -->
        <LinearLayout
            android:id="@+id/notif_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/notif_mode_icon"
            android:layout_toStartOf="@id/notif_btn_cancel"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_extra_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Center: Transit-Style Segmented Progress Bar Image (Proportional, edge-to-edge, non-distorted) -->
    <ImageView
        android:id="@+id/notif_progress_bar_image"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="Progreso de la ruta" />

    <!-- Bottom Row: Arrival Time & Total Duration -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notif_dest_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location_notification"
                android:contentDescription="Llegada" />

            <TextView
                android:id="@+id/notif_eta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Right Side: Live Badge & Remaining Duration -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_live_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#00A86B"
                android:text="● En directe" />

            <TextView
                android:id="@+id/notif_duration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
